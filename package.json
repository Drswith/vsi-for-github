{
  "name": "vsi-for-github",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub file icons powered by vscode-icons",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm validate:assets && vite build && node scripts/copy-distribution-notices.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm package",
    "test": "node --test tests/*.test.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "sync:upstream": "node scripts/sync-vscode-icons.mjs",
    "package": "node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "jsdom": "30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
